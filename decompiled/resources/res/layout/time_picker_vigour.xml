<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="@style/TextAppearance.Vigour.TimePicker.PromptLabel"
        android:gravity="center_horizontal"
        android:id="@+id/vigour_header_top_label"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/time_picker_prompt_label"/>
    <include
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vigour_timepicker_header_height"
        layout="@layout/time_picker_header_vigour"/>
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vigour_timepicker_radial_picker_top_margin">
        <com.vos.widget.VRadialTimePickerView
            android:layout_gravity="center"
            android:id="@+id/radial_picker"
            android:layout_width="@dimen/vigour_timepicker_radial_picker_dimen"
            android:layout_height="@dimen/vigour_timepicker_radial_picker_dimen"
            android:layout_marginStart="@dimen/vigour_timepicker_radial_picker_horizontal_margin"
            android:layout_marginEnd="@dimen/vigour_timepicker_radial_picker_horizontal_margin"/>
        <com.vos.widget.VTextInputTimePickerView
            android:layout_gravity="center_horizontal"
            android:id="@+id/input_mode"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="?attr/dialogPreferredPadding"
            android:paddingEnd="?attr/dialogPreferredPadding"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="right"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/toggle_mode"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/vigour_ic_btn_keyboard_key"
            android:tint="?attr/colorControlNormal"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"/>
    </LinearLayout>
</LinearLayout>
