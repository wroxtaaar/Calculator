<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" android:shareInterpolator="false">
    <alpha
        android:interpolator="@anim/vigour_window_enter_alpha_interpolator"
        android:duration="300"
        android:fromAlpha="0"
        android:toAlpha="1"/>
    <scale
        android:interpolator="@anim/vigour_window_enter_scale_interpolator"
        android:duration="300"
        android:pivotX="50%"
        android:pivotY="50%"
        android:fromXScale="0.8"
        android:toXScale="1"
        android:fromYScale="0.8"
        android:toYScale="1"/>
</set>
