<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="2123"
    android:versionName="2.1.2.3"
    android:compileSdkVersion="34"
    android:compileSdkVersionCodename="14"
    package="com.vivo.calculator"
    platformBuildVersionCode="34"
    platformBuildVersionName="14">
    <uses-sdk
        android:minSdkVersion="29"
        android:targetSdkVersion="33"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.START_ACTIVITIES_FROM_BACKGROUND"/>
    <uses-permission android:name="android.permission.smartmultiwindow.SMARTMULTIWINDOW_OP"/>
    <uses-permission android:name="com.vivo.abe.permission.exidentifier.provider"/>
    <permission
        android:name="com.vivo.abe.permission.exidentifier.provider"
        android:protectionLevel="signature"/>
    <application
        android:theme="@style/ThemeVivo"
        android:label="@string/app_name"
        android:icon="@drawable/icon"
        android:name="com.vivo.calculator.BBKCalculatorApplication"
        android:debuggable="false"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:extractNativeLibs="false"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory">
        <meta-data
            android:name="com.vivo.systemui.navColorFollowSystem"
            android:value="custom"/>
        <meta-data
            android:name="com.vivo.window.fringeadopt"
            android:value="true"/>
        <activity
            android:theme="@style/ThemeVivo"
            android:name="com.vivo.calculator.Calculator"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="android.intent.category.APP_CALCULATOR"/>
            </intent-filter>
            <intent-filter>
                <action android:name="vivo.intent.action.VIVO_CALCULATOR_SECURE"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <activity
            android:theme="@style/SettingTheme"
            android:name="com.vivo.calculator.ExchangeActivity"
            android:exported="false"
            android:resizeableActivity="false"/>
        <activity
            android:theme="@style/SettingTheme"
            android:name="com.vivo.calculator.CalculatorSettingActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:configChanges="screenSize|screenLayout|orientation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="vivo.intent.category.settings.MAIN"/>
            </intent-filter>
        </activity>
        <activity
            android:theme="@style/notitleBar"
            android:name="com.vivo.calculator.exchangelist.CountryList"
            android:exported="false"
            android:screenOrientation="behind"
            android:configChanges="smallestScreenSize|screenSize|screenLayout|orientation"
            android:windowSoftInputMode="adjustPan|stateAlwaysHidden"
            android:resizeableActivity="false"/>
        <activity
            android:theme="@style/notitleBar"
            android:name="com.vivo.calculator.exchangelist.CountryListSearchResult"
            android:exported="false"
            android:screenOrientation="behind"
            android:configChanges="smallestScreenSize|screenSize|screenLayout|orientation"
            android:windowSoftInputMode="adjustPan|stateAlwaysHidden"
            android:resizeableActivity="false"/>
        <provider
            android:name="com.vivo.calculator.helper.CountryProvide"
            android:exported="false"
            android:authorities="com.vivo.calculator.CountryProvide"/>
        <meta-data
            android:name="com.vivo.vcode.moduleId"
            android:value="@string/module_id"/>
        <meta-data
            android:name="com.vivo.vcode.netConnect"
            android:value="false"/>
        <meta-data
            android:name="vivo.cold_start_capture_enable"
            android:value="true"/>
    </application>
</manifest>
