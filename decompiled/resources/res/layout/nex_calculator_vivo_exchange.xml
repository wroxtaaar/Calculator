<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:screenOrientation="portrait"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/calculator_exchange_layout"
        android:background="@color/calculator_background"
        android:paddingLeft="0dp"
        android:paddingTop="0dp"
        android:paddingRight="0dp"
        android:paddingBottom="@dimen/calculator_paddingbottom_portrait"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true">
        <com.vos.widget.VToolBar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/vigour_back_icon"
            app:title="@string/title_exchange"/>
        <RelativeLayout
            android:id="@+id/display_ex_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/source_layout"
            android:layout_below="@+id/toolbar">
            <com.vivo.calculator.RefreshLinearLayout
                android:id="@+id/refresh_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/exchange_net_button_top">
                <ViewStub
                    android:layout_gravity="center_vertical"
                    android:id="@+id/no_net_viewstub"
                    android:layout="@layout/no_connection_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <ViewStub
                    android:layout_gravity="center_vertical"
                    android:id="@+id/net_error_viewstub"
                    android:layout="@layout/net_error_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/countrys"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/refresh_layout">
                <com.vivo.calculator.pulltorefresh.PullToRefreshScrollView
                    android:id="@+id/pull_to_refresh"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/exchange_input_margin_start"
                        android:layout_marginEnd="@dimen/exchange_input_margin_start">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <RelativeLayout
                                android:gravity="center_vertical"
                                android:id="@+id/other_countrys"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <RelativeLayout
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:id="@+id/other_country_info"
                                    android:longClickable="true"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/exchange_currency_info_height"
                                    android:layout_marginTop="@dimen/input_margin_top"
                                    android:layout_alignParentStart="true">
                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_centerVertical="true"
                                        android:layout_toStartOf="@+id/arrow_icon"
                                        android:layout_alignParentStart="true">
                                        <LinearLayout
                                            android:orientation="horizontal"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content">
                                            <TextView
                                                android:textSize="@dimen/exchange_text_size"
                                                android:textStyle="bold"
                                                android:textColor="@color/currency_text_color"
                                                android:ellipsize="end"
                                                android:gravity="start|center_vertical"
                                                android:id="@+id/other_currency"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:singleLine="true"
                                                android:layout_weight="1"/>
                                            <TextView
                                                android:textSize="@dimen/exchange_text_size"
                                                android:textStyle="bold"
                                                android:textColor="@color/currency_code_text_color"
                                                android:gravity="start|center_vertical"
                                                android:id="@+id/other_currency_code"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:maxEms="3"
                                                android:singleLine="true"
                                                android:importantForAccessibility="no"
                                                android:layout_marginStart="6dp"/>
                                        </LinearLayout>
                                    </LinearLayout>
                                    <ImageView
                                        android:id="@+id/arrow_icon"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:src="@drawable/arrow_icon"
                                        android:layout_centerVertical="true"
                                        android:contentDescription=""
                                        android:layout_marginStart="4dp"
                                        android:layout_alignParentEnd="true"/>
                                </RelativeLayout>
                                <LinearLayout
                                    android:textStyle="normal"
                                    android:orientation="vertical"
                                    android:id="@+id/other_country_input"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/exchange_input_all_height"
                                    android:layout_below="@+id/other_country_info"
                                    android:layoutDirection="ltr">
                                    <com.vivo.calculator.exchange.InputTextView
                                        android:textSize="@dimen/exchange_input_text_size"
                                        android:textStyle="normal"
                                        android:textColor="@color/edit_text_color"
                                        android:textColorHighlight="@color/handle_color"
                                        android:gravity="center"
                                        android:layout_gravity="end"
                                        android:id="@+id/other_input"
                                        android:background="@null"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/exchange_input_height"
                                        android:layout_marginTop="@dimen/exchange_input_margin_top"
                                        android:layout_marginBottom="0dp"
                                        android:includeFontPadding="false"
                                        android:textSelectHandleLeft="@drawable/my_cursor"
                                        android:textSelectHandleRight="@drawable/my_cursor"
                                        android:textSelectHandle="@drawable/text_select_handle_middle"
                                        android:textCursorDrawable="@drawable/my_excursor"
                                        android:textDirection="ltr"
                                        android:layoutDirection="ltr"
                                        android:paddingStart="2dp"
                                        android:paddingEnd="0dp"/>
                                    <com.vivo.calculator.exchange.CalculatorOthResult
                                        android:enabled="false"
                                        android:textSize="@dimen/exchange_result_text_size"
                                        android:textColor="@color/result_text_color"
                                        android:textColorHighlight="@color/handle_color"
                                        android:gravity="center"
                                        android:layout_gravity="end"
                                        android:id="@+id/other_result"
                                        android:background="@null"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/exchange_result_height"
                                        android:layout_marginTop="4dp"
                                        android:includeFontPadding="false"
                                        android:textSelectHandleLeft="@drawable/my_cursor"
                                        android:textSelectHandleRight="@drawable/my_cursor"
                                        android:alpha="1"
                                        android:textDirection="ltr"
                                        android:layoutDirection="ltr"
                                        android:paddingStart="2dp"
                                        android:paddingEnd="0dp"/>
                                </LinearLayout>
                                <View
                                    android:id="@+id/line_one"
                                    android:background="@color/ex_line_of_color"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/divide_exline_height"
                                    android:layout_marginTop="6dp"
                                    android:layout_below="@+id/other_country_input"
                                    android:layout_alignParentBottom="true"/>
                            </RelativeLayout>
                            <RelativeLayout
                                android:gravity="center_vertical"
                                android:id="@+id/local_countrys"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <RelativeLayout
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:id="@+id/local_country_info"
                                    android:longClickable="true"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/exchange_currency_info_height"
                                    android:layout_marginTop="@dimen/input_margin_top"
                                    android:layout_alignParentStart="true">
                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_centerVertical="true"
                                        android:layout_toStartOf="@+id/arrow_icon1"
                                        android:layout_alignParentStart="true">
                                        <LinearLayout
                                            android:orientation="horizontal"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content">
                                            <TextView
                                                android:textSize="@dimen/exchange_text_size"
                                                android:textStyle="bold"
                                                android:textColor="@color/currency_text_color"
                                                android:ellipsize="end"
                                                android:gravity="start|center_vertical"
                                                android:id="@+id/local_currency"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:singleLine="true"
                                                android:layout_weight="1"/>
                                            <TextView
                                                android:textSize="@dimen/exchange_text_size"
                                                android:textStyle="bold"
                                                android:textColor="@color/currency_code_text_color"
                                                android:gravity="start|center_vertical"
                                                android:id="@+id/local_currency_code"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:maxEms="3"
                                                android:singleLine="true"
                                                android:importantForAccessibility="no"
                                                android:layout_marginStart="6dp"/>
                                        </LinearLayout>
                                    </LinearLayout>
                                    <ImageView
                                        android:id="@+id/arrow_icon1"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:src="@drawable/arrow_icon"
                                        android:layout_centerVertical="true"
                                        android:contentDescription=""
                                        android:layout_marginStart="4dp"
                                        android:layout_alignParentEnd="true"/>
                                </RelativeLayout>
                                <LinearLayout
                                    android:textStyle="normal"
                                    android:orientation="vertical"
                                    android:id="@+id/local_country_input"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/exchange_input_all_height"
                                    android:layout_below="@+id/local_country_info"
                                    android:layoutDirection="ltr">
                                    <com.vivo.calculator.exchange.InputTextView
                                        android:textSize="@dimen/exchange_input_text_size"
                                        android:textStyle="normal"
                                        android:textColor="@color/edit_text_color"
                                        android:textColorHighlight="@color/handle_color"
                                        android:gravity="center"
                                        android:layout_gravity="end"
                                        android:id="@+id/local_input"
                                        android:background="@null"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/exchange_input_height"
                                        android:layout_marginTop="@dimen/exchange_input_margin_top"
                                        android:layout_marginBottom="0dp"
                                        android:includeFontPadding="false"
                                        android:textSelectHandleLeft="@drawable/my_cursor"
                                        android:textSelectHandleRight="@drawable/my_cursor"
                                        android:textSelectHandle="@drawable/text_select_handle_middle"
                                        android:textCursorDrawable="@drawable/my_excursor"
                                        android:paddingStart="2dp"
                                        android:paddingEnd="0dp"/>
                                    <com.vivo.calculator.exchange.CalculatorLocResult
                                        android:textSize="@dimen/exchange_result_text_size"
                                        android:textStyle="normal"
                                        android:textColor="@color/result_text_color"
                                        android:textColorHighlight="@color/handle_color"
                                        android:gravity="center"
                                        android:layout_gravity="end"
                                        android:id="@+id/local_result"
                                        android:background="@null"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/exchange_result_height"
                                        android:layout_marginTop="4dp"
                                        android:includeFontPadding="false"
                                        android:textSelectHandleLeft="@drawable/my_cursor"
                                        android:textSelectHandleRight="@drawable/my_cursor"
                                        android:alpha="1"
                                        android:paddingStart="2dp"
                                        android:paddingEnd="0dp"/>
                                </LinearLayout>
                                <View
                                    android:id="@+id/line_two"
                                    android:background="@color/ex_line_of_color"
                                    android:visibility="gone"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/divide_exline_height"
                                    android:layout_marginTop="6dp"
                                    android:layout_below="@+id/local_country_input"/>
                            </RelativeLayout>
                        </LinearLayout>
                    </RelativeLayout>
                </com.vivo.calculator.pulltorefresh.PullToRefreshScrollView>
            </RelativeLayout>
            <LinearLayout
                android:id="@+id/header_linearlayout"
                android:background="@color/refresh_background"
                android:layout_width="match_parent"
                android:layout_height="40dp">
                <com.vivo.calculator.RefreshHeaderLayout
                    android:gravity="bottom|center_horizontal"
                    android:id="@+id/header_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:translationY="-40dp">
                    <ProgressBar
                        android:scrollbarSize="5dp"
                        android:id="@+id/refresh_pb_new"
                        android:visibility="gone"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        style="@style/VigourProgressBarSmall"/>
                    <TextView
                        android:textSize="14dp"
                        android:textColor="@color/update_text_color"
                        android:id="@+id/refresh_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="@string/being_update"/>
                </com.vivo.calculator.RefreshHeaderLayout>
            </LinearLayout>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/source_layout"
            android:background="@color/calculator_background"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/keyboard_ex_layout">
            <TextView
                android:textSize="10dp"
                android:textColor="@color/window_ex_prompt_color"
                android:gravity="center"
                android:id="@+id/net_notification"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="320dp"
                android:text="@string/no_internet"
                android:lineHeight="@dimen/exchange_source_height"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/window_ex_prompt_color"
                android:gravity="center"
                android:id="@+id/data_notification"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="320dp"
                android:lineHeight="@dimen/exchange_source_height"/>
        </LinearLayout>
        <View
            android:id="@+id/divid_layout"
            android:background="@color/line_of_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divide_line_height"
            android:layout_marginLeft="@dimen/line_margin_right"
            android:layout_marginRight="@dimen/line_margin_right"
            android:layout_above="@+id/keyboard_ex_layout"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/keyboard_ex_layout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/keybord_ex_height_nex"
            android:baselineAligned="false"
            android:layout_alignParentBottom="true"
            android:layoutDirection="ltr"
            android:layout_marginStart="@dimen/keybord_margin"
            android:layout_marginEnd="@dimen/keybord_margin">
            <RelativeLayout
                android:id="@+id/history_layout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="@integer/keguard_main_weight">
                <include
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    layout="@layout/pad_numeric_exchange_nex"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="@integer/keguard_one_col_weight">
                <include layout="@layout/pad_exchage_operator_one_col_nex"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
