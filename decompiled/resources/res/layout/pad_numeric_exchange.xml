<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pad_numeric"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:rowCount="12"
    android:columnCount="7">
    <Space
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="0"
        android:layout_row="2"
        android:layout_rowWeight="@integer/keyguard_middle_layout_rowWeight"
        android:layout_columnWeight="@integer/keyguard_layout_columnWeight"/>
    <com.vivo.calculator.keybord.ColorExButton
        android:textSize="@dimen/text_size_ac"
        android:id="@+id/e_clr"
        android:src="@drawable/ac"
        android:layout_column="0"
        android:text="@string/text_ac"
        android:contentDescription="@string/description_mc"
        android:layout_row="3"
        android:layout_rowWeight="@integer/keyguard_layout_rowWeight"
        android:layout_columnWeight="@integer/keyguard_layout_columnWeight"
        style="@style/rom_for_button_style"/>
    <Space
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="1"
        android:layout_row="3"
        android:layout_rowWeight="11"
        android:layout_columnWeight="@integer/keyguard_middle_layout_columnWeight"/>
    <com.vivo.calculator.keybord.ColorExButton
        android:textSize="@dimen/exchange_operate"
        android:id="@+id/e_del"
        android:src="@drawable/clear"
        android:scaleType="centerInside"
        android:layout_column="2"
        android:contentDescription="@string/description_clear1"
        android:layout_row="3"
        android:layout_rowWeight="@integer/keyguard_layout_rowWeight"
        android:layout_columnWeight="@integer/keyguard_layout_columnWeight"
        style="@style/rom_for_button_style"/>
    <Space
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="3"
        android:layout_row="3"
        android:layout_rowWeight="11"
        android:layout_columnWeight="@integer/keyguard_middle_layout_columnWeight"/>
    <com.vivo.calculator.keybord.ColorExButton
        android:textSize="@dimen/exchange_operate"
        android:id="@+id/e_op_mul"
        android:src="@drawable/chenghao"
        android:layout_column="4"
        android:text="@string/op_mul"
        android:contentDescription="@string/description_mul"
        android:layout_row="3"
        android:layout_rowWeight="@integer/keyguard_layout_rowWeight"
        android:layout_columnWeight="@integer/keyguard_layout_columnWeight"
        style="@style/rom_for_button_style"/>
    <Space
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="5"
        android:layout_row="3"
        android:layout_rowWeight="11"
        android:layout_columnWeight="@integer/keyguard_middle_layout_columnWeight"/>
    <Space
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="0"
        android:layout_row="4"
        android:layout_rowWeight="@integer/keyguard_middle_layout_rowWeight"
        android:layout_columnWeight="@integer/keyguard_layout_columnWeight"/>
    <com.vivo.calculator.keybord.ColorExButton
        android:id="@+id/e_digit_7"
        android:src="@drawable/digit7"
        android:layout_column="0"
        android:text="@string/digit_7"
        android:layout_row="5"
        android:layout_rowWeight="@integer/keyguard_layout_rowWeight"
        android:layout_columnWeight="@integer/keyguard_layout_columnWeight"
        style="@style/style_text_digital"/>
    <Space
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="1"
        android:layout_row="5"
        android:layout_rowWeight="12"
        android:layout_columnWeight="@integer/keyguard_middle_layout_columnWeight"/>
    <com.vivo.calculator.keybord.ColorExButton
        android:id="@+id/e_digit_8"
        android:src="@drawable/digit8"
        android:layout_column="2"
        android:text="@string/digit_8"
        android:layout_row="5"
        android:layout_rowWeight="@integer/keyguard_layout_rowWeight"
        android:layout_columnWeight="@integer/keyguard_layout_columnWeight"
        style="@style/style_text_digital"/>
    <Space
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="3"
        android:layout_row="5"
        android:layout_rowWeight="12"
        android:layout_columnWeight="@integer/keyguard_middle_layout_columnWeight"/>
    <com.vivo.calculator.keybord.ColorExButton
        android:id="@+id/e_digit_9"
        android:src="@drawable/digit9"
        android:layout_column="4"
        android:text="@string/digit_9"
        android:layout_row="5"
        android:layout_rowWeight="@integer/keyguard_layout_rowWeight"
        android:layout_columnWeight="@integer/keyguard_layout_columnWeight"
        style="@style/style_text_digital"/>
    <Space
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="5"
        android:layout_row="5"
        android:layout_rowWeight="12"
        android:layout_columnWeight="@integer/keyguard_middle_layout_columnWeight"/>
    <Space
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="0"
        android:layout_row="6"
        android:layout_rowWeight="@integer/keyguard_middle_layout_rowWeight"
        android:layout_columnWeight="@integer/keyguard_layout_columnWeight"/>
    <com.vivo.calculator.keybord.ColorExButton
        android:id="@+id/e_digit_4"
        android:src="@drawable/digit4"
        android:layout_column="0"
        android:text="@string/digit_4"
        android:layout_row="7"
        android:layout_rowWeight="@integer/keyguard_layout_rowWeight"
        android:layout_columnWeight="@integer/keyguard_layout_columnWeight"
        style="@style/style_text_digital"/>
    <Space
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="1"
        android:layout_row="7"
        android:layout_rowWeight="12"
        android:layout_columnWeight="@integer/keyguard_middle_layout_columnWeight"/>
    <com.vivo.calculator.keybord.ColorExButton
        android:id="@+id/e_digit_5"
        android:src="@drawable/digit5"
        android:layout_column="2"
        android:text="@string/digit_5"
        android:layout_row="7"
        android:layout_rowWeight="@integer/keyguard_layout_rowWeight"
        android:layout_columnWeight="@integer/keyguard_layout_columnWeight"
        style="@style/style_text_digital"/>
    <Space
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="3"
        android:layout_row="7"
        android:layout_rowWeight="12"
        android:layout_columnWeight="@integer/keyguard_middle_layout_columnWeight"/>
    <com.vivo.calculator.keybord.ColorExButton
        android:id="@+id/e_digit_6"
        android:src="@drawable/digit6"
        android:layout_column="4"
        android:text="@string/digit_6"
        android:layout_row="7"
        android:layout_rowWeight="@integer/keyguard_layout_rowWeight"
        android:layout_columnWeight="@integer/keyguard_layout_columnWeight"
        style="@style/style_text_digital"/>
    <Space
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="5"
        android:layout_row="7"
        android:layout_rowWeight="12"
        android:layout_columnWeight="@integer/keyguard_middle_layout_columnWeight"/>
    <Space
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="0"
        android:layout_row="8"
        android:layout_rowWeight="@integer/keyguard_middle_layout_rowWeight"
        android:layout_columnWeight="@integer/keyguard_layout_columnWeight"/>
    <com.vivo.calculator.keybord.ColorExButton
        android:id="@+id/e_digit_1"
        android:src="@drawable/digit1"
        android:layout_column="0"
        android:text="@string/digit_1"
        android:layout_row="9"
        android:layout_rowWeight="@integer/keyguard_layout_rowWeight"
        android:layout_columnWeight="@integer/keyguard_layout_columnWeight"
        style="@style/style_text_digital"/>
    <Space
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="1"
        android:layout_row="9"
        android:layout_rowWeight="12"
        android:layout_columnWeight="@integer/keyguard_middle_layout_columnWeight"/>
    <com.vivo.calculator.keybord.ColorExButton
        android:id="@+id/e_digit_2"
        android:src="@drawable/digit2"
        android:layout_column="2"
        android:text="@string/digit_2"
        android:layout_row="9"
        android:layout_rowWeight="@integer/keyguard_layout_rowWeight"
        android:layout_columnWeight="@integer/keyguard_layout_columnWeight"
        style="@style/style_text_digital"/>
    <Space
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="3"
        android:layout_row="9"
        android:layout_rowWeight="12"
        android:layout_columnWeight="@integer/keyguard_middle_layout_columnWeight"/>
    <com.vivo.calculator.keybord.ColorExButton
        android:id="@+id/e_digit_3"
        android:src="@drawable/digit3"
        android:layout_column="4"
        android:text="@string/digit_3"
        android:layout_row="9"
        android:layout_rowWeight="@integer/keyguard_layout_rowWeight"
        android:layout_columnWeight="@integer/keyguard_layout_columnWeight"
        style="@style/style_text_digital"/>
    <Space
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="5"
        android:layout_row="9"
        android:layout_rowWeight="12"
        android:layout_columnWeight="@integer/keyguard_middle_layout_columnWeight"/>
    <Space
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="0"
        android:layout_row="10"
        android:layout_rowWeight="@integer/keyguard_middle_layout_rowWeight"
        android:layout_columnWeight="@integer/keyguard_layout_columnWeight"/>
    <com.vivo.calculator.keybord.ColorExButton
        android:id="@+id/e_digit_00"
        android:src="@drawable/digit00"
        android:layout_column="0"
        android:text="@string/digit_00"
        android:contentDescription="@string/digit_00"
        android:layout_row="11"
        android:layout_rowWeight="@integer/keyguard_layout_rowWeight"
        android:layout_columnWeight="@integer/keyguard_layout_columnWeight"
        style="@style/style_text_digital"/>
    <Space
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="1"
        android:layout_row="11"
        android:layout_rowWeight="12"
        android:layout_columnWeight="11"/>
    <com.vivo.calculator.keybord.ColorExButton
        android:id="@+id/e_digit_0"
        android:src="@drawable/digit0"
        android:layout_column="2"
        android:text="@string/digit_0"
        android:layout_row="11"
        android:layout_rowWeight="@integer/keyguard_layout_rowWeight"
        android:layout_columnWeight="@integer/keyguard_layout_columnWeight"
        style="@style/style_text_digital"/>
    <Space
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="3"
        android:layout_row="11"
        android:layout_rowWeight="12"
        android:layout_columnWeight="11"/>
    <com.vivo.calculator.keybord.ColorExButton
        android:id="@+id/e_dec_point"
        android:src="@drawable/dot"
        android:layout_column="4"
        android:text="@string/text_dot"
        android:contentDescription="@string/description_dot"
        android:layout_row="11"
        android:layout_rowWeight="@integer/keyguard_layout_rowWeight"
        android:layout_columnWeight="@integer/keyguard_layout_columnWeight"
        style="@style/style_text_digital"/>
    <Space
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="5"
        android:layout_row="11"
        android:layout_rowWeight="12"
        android:layout_columnWeight="@integer/keyguard_middle_layout_columnWeight"/>
</GridLayout>
