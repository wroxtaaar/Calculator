<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/setting_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.vivo.calculator.exchangelist.CurrencySearchView
        android:gravity="center_vertical"
        android:id="@+id/search_view"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"/>
    <View
        android:background="@color/line_of_color"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="?attr/actionBarSize"/>
    <ListView
        android:id="@+id/search_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:layout_below="@+id/search_view"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/search_emptyText"
        android:paddingTop="@dimen/search_result_empty_margin_top"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/search_view">
        <ImageView
            android:layout_gravity="center"
            android:background="@drawable/no_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription=""/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/exchange_net_notification_text_color"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/no_result"/>
    </LinearLayout>
</RelativeLayout>
