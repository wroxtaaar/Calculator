<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calculator_main_layout"
    android:background="@color/calculator_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/display_mul_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="65dp"
        android:baselineAligned="false"
        android:layout_above="@+id/keyboard_layout">
        <LinearLayout
            android:gravity="right"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/result_area_margin_mul_nex"
            android:layout_marginRight="@dimen/result_area_margin_mul_nex">
            <com.vivo.calculator.CalculatorFormula
                android:textSize="35dp"
                android:textStyle="normal"
                android:textColor="@color/edit_text_color"
                android:textColorHighlight="@color/handle_color"
                android:gravity="center"
                android:id="@+id/formula"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="@dimen/calculator_input_height_nex"
                android:contentDescription="@string/description_input"
                android:textSelectHandleLeft="@drawable/my_cursor"
                android:textSelectHandleRight="@drawable/my_cursor"
                android:textSelectHandle="@drawable/text_select_handle_middle"
                android:textCursorDrawable="@drawable/my_excursor"/>
            <com.vivo.calculator.CalculatorResult
                android:textSize="22dp"
                android:textStyle="normal"
                android:textColor="@color/result_text_color"
                android:textColorHighlight="@color/handle_color"
                android:gravity="center"
                android:id="@+id/result"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="@dimen/calculator_result_height_nex"
                android:textSelectHandleLeft="@drawable/my_cursor"
                android:textSelectHandleRight="@drawable/my_cursor"/>
        </LinearLayout>
        <RelativeLayout
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <ImageButton
                android:id="@+id/history_toge_button"
                android:background="@drawable/history_open"
                android:layout_width="@dimen/btn_size"
                android:layout_height="@dimen/btn_size"
                android:layout_marginLeft="@dimen/togglebutton_paddingleft_mul"
                android:layout_marginTop="@dimen/togglebutton_paddingbottom_mul"
                android:layout_marginRight="@dimen/togglebutton_paddingleft_mul"
                android:layout_marginBottom="4dp"
                android:layout_alignParentBottom="true"
                android:contentDescription="@string/description_history_open"/>
            <TextView
                android:textColor="@color/calculator_mode_color"
                android:gravity="right"
                android:id="@+id/mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/raddeg_paddingTop_mul"
                android:text="@string/degradtext"
                android:layout_alignParentTop="true"
                android:layout_marginStart="@dimen/raddeg_paddingleft_mul"/>
        </RelativeLayout>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/keyboard_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/keyboard_height_nex"
        android:layout_marginBottom="@dimen/keyguard_margin_bottom_nex"
        android:layout_alignParentBottom="true"
        android:layoutDirection="ltr"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <com.vivo.calculator.HistoryLayout
            android:id="@+id/history_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <GridLayout
                android:id="@+id/pad_numeric"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:rowCount="11"
                android:columnCount="8">
                <Space
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_column="0"
                    android:layout_row="2"
                    android:layout_rowWeight="23"
                    android:layout_columnWeight="3.5"/>
                <Space
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_column="2"
                    android:layout_row="2"
                    android:layout_rowWeight="23"
                    android:layout_columnWeight="7"/>
                <Space
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_column="4"
                    android:layout_row="2"
                    android:layout_rowWeight="23"
                    android:layout_columnWeight="7"/>
                <Space
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_column="6"
                    android:layout_row="2"
                    android:layout_rowWeight="23"
                    android:layout_columnWeight="7"/>
                <Space
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_column="0"
                    android:layout_row="3"
                    android:layout_rowWeight="7"
                    android:layout_columnWeight="3.5"/>
                <Space
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_column="0"
                    android:layout_row="4"
                    android:layout_rowWeight="23"
                    android:layout_columnWeight="3.5"/>
                <Space
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_column="2"
                    android:layout_row="4"
                    android:layout_rowWeight="23"
                    android:layout_columnWeight="7"/>
                <Space
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_column="4"
                    android:layout_row="4"
                    android:layout_rowWeight="23"
                    android:layout_columnWeight="7"/>
                <Space
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_column="6"
                    android:layout_row="4"
                    android:layout_rowWeight="23"
                    android:layout_columnWeight="7"/>
                <Space
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_column="0"
                    android:layout_row="5"
                    android:layout_rowWeight="7"
                    android:layout_columnWeight="3.5"/>
                <Space
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_column="0"
                    android:layout_row="6"
                    android:layout_rowWeight="7"
                    android:layout_columnWeight="3.5"/>
                <Space
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_column="2"
                    android:layout_row="6"
                    android:layout_rowWeight="7"
                    android:layout_columnWeight="7"/>
                <Space
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_column="4"
                    android:layout_row="6"
                    android:layout_rowWeight="7"
                    android:layout_columnWeight="7"/>
                <Space
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_column="6"
                    android:layout_row="6"
                    android:layout_rowWeight="7"
                    android:layout_columnWeight="7"/>
                <Space
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_column="0"
                    android:layout_row="7"
                    android:layout_rowWeight="7"
                    android:layout_columnWeight="3.5"/>
                <Space
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_column="0"
                    android:layout_row="8"
                    android:layout_rowWeight="7"
                    android:layout_columnWeight="3.5"/>
                <Space
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_column="2"
                    android:layout_row="8"
                    android:layout_rowWeight="7"
                    android:layout_columnWeight="7"/>
                <Space
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_column="4"
                    android:layout_row="8"
                    android:layout_rowWeight="7"
                    android:layout_columnWeight="7"/>
                <Space
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_column="6"
                    android:layout_row="8"
                    android:layout_rowWeight="7"
                    android:layout_columnWeight="7"/>
                <Space
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_column="0"
                    android:layout_row="9"
                    android:layout_rowWeight="7"
                    android:layout_columnWeight="3.5"/>
                <Space
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_column="0"
                    android:layout_row="10"
                    android:layout_rowWeight="7"
                    android:layout_columnWeight="3.5"/>
                <Space
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_column="2"
                    android:layout_row="10"
                    android:layout_rowWeight="7"
                    android:layout_columnWeight="7"/>
                <com.vivo.calculator.keybord.ColorButton
                    android:id="@+id/digit_7"
                    android:src="@drawable/digit7_mul_select"
                    android:scaleType="fitCenter"
                    android:layout_column="1"
                    android:text="@string/digit_7"
                    android:layout_row="4"
                    android:layout_rowWeight="39"
                    android:layout_columnWeight="53"
                    style="@style/multiwindow_button_digital_normal"/>
                <com.vivo.calculator.keybord.ColorButton
                    android:id="@+id/digit_8"
                    android:src="@drawable/digit8_mul_select"
                    android:scaleType="fitCenter"
                    android:layout_column="3"
                    android:text="@string/digit_8"
                    android:layout_row="4"
                    android:layout_rowWeight="39"
                    android:layout_columnWeight="53"
                    style="@style/multiwindow_button_digital_normal"/>
                <com.vivo.calculator.keybord.ColorButton
                    android:id="@+id/digit_9"
                    android:src="@drawable/digit9_mul_select"
                    android:scaleType="fitCenter"
                    android:layout_column="5"
                    android:text="@string/digit_9"
                    android:layout_row="4"
                    android:layout_rowWeight="39"
                    android:layout_columnWeight="53"
                    style="@style/multiwindow_button_digital_normal"/>
                <com.vivo.calculator.keybord.ColorButton
                    android:id="@+id/digit_4"
                    android:src="@drawable/digit4_mul_select"
                    android:scaleType="fitCenter"
                    android:layout_column="1"
                    android:text="@string/digit_4"
                    android:layout_row="6"
                    android:layout_rowWeight="39"
                    android:layout_columnWeight="53"
                    style="@style/multiwindow_button_digital_normal"/>
                <com.vivo.calculator.keybord.ColorButton
                    android:id="@+id/digit_5"
                    android:src="@drawable/digit5_mul_select"
                    android:scaleType="fitCenter"
                    android:layout_column="3"
                    android:text="@string/digit_5"
                    android:layout_row="6"
                    android:layout_rowWeight="39"
                    android:layout_columnWeight="53"
                    style="@style/multiwindow_button_digital_normal"/>
                <com.vivo.calculator.keybord.ColorButton
                    android:id="@+id/digit_6"
                    android:src="@drawable/digit6_mul_select"
                    android:scaleType="fitCenter"
                    android:layout_column="5"
                    android:text="@string/digit_6"
                    android:layout_row="6"
                    android:layout_rowWeight="39"
                    android:layout_columnWeight="53"
                    style="@style/multiwindow_button_digital_normal"/>
                <com.vivo.calculator.keybord.ColorButton
                    android:id="@+id/digit_1"
                    android:src="@drawable/digit1_mul_select"
                    android:scaleType="fitCenter"
                    android:layout_column="1"
                    android:text="@string/digit_1"
                    android:layout_row="8"
                    android:layout_rowWeight="39"
                    android:layout_columnWeight="53"
                    style="@style/multiwindow_button_digital_normal"/>
                <com.vivo.calculator.keybord.ColorButton
                    android:id="@+id/digit_2"
                    android:src="@drawable/digit2_mul_select"
                    android:scaleType="fitCenter"
                    android:layout_column="3"
                    android:text="@string/digit_2"
                    android:layout_row="8"
                    android:layout_rowWeight="39"
                    android:layout_columnWeight="53"
                    style="@style/multiwindow_button_digital_normal"/>
                <com.vivo.calculator.keybord.ColorButton
                    android:id="@+id/digit_3"
                    android:src="@drawable/digit3_mul_select"
                    android:scaleType="fitCenter"
                    android:layout_column="5"
                    android:text="@string/digit_3"
                    android:layout_row="8"
                    android:layout_rowWeight="39"
                    android:layout_columnWeight="53"
                    style="@style/multiwindow_button_digital_normal"/>
                <com.vivo.calculator.keybord.ColorButton
                    android:textColor="@color/symbol_text_color"
                    android:id="@+id/op_pct"
                    android:src="@drawable/percent_mul_select"
                    android:scaleType="fitCenter"
                    android:layout_column="1"
                    android:text="@string/text_percentsign"
                    android:contentDescription="@string/description_percent"
                    android:layout_row="10"
                    android:layout_rowWeight="39"
                    android:layout_columnWeight="53"
                    style="@style/rom_four_button_style_mul_blue"/>
                <com.vivo.calculator.keybord.ColorButton
                    android:id="@+id/digit_0"
                    android:src="@drawable/digit0_mul_select"
                    android:scaleType="fitCenter"
                    android:layout_column="3"
                    android:text="@string/digit_0"
                    android:layout_row="10"
                    android:layout_rowWeight="39"
                    android:layout_columnWeight="53"
                    style="@style/multiwindow_button_digital_normal"/>
                <com.vivo.calculator.keybord.ColorButton
                    android:textSize="@dimen/windowmul_del"
                    android:id="@+id/dec_point"
                    android:src="@drawable/dot_mul_select"
                    android:scaleType="fitCenter"
                    android:layout_column="5"
                    android:text="@string/text_dot"
                    android:contentDescription="@string/description_dot"
                    android:layout_row="10"
                    android:layout_rowWeight="39"
                    android:layout_columnWeight="53"
                    style="@style/multiwindow_button_digital_normal"/>
                <com.vivo.calculator.keybord.ColorButton
                    android:textSize="@dimen/windowmul_operate"
                    android:id="@+id/op_div"
                    android:src="@drawable/chuhao_mul_select"
                    android:scaleType="fitCenter"
                    android:layout_column="7"
                    android:text="@string/chuhao"
                    android:contentDescription="@string/description_div"
                    android:layout_row="2"
                    android:layout_rowWeight="39"
                    android:layout_columnWeight="53"
                    style="@style/rom_four_button_style_mul_blue"/>
                <com.vivo.calculator.keybord.ColorButton
                    android:textSize="@dimen/windowmul_operate"
                    android:id="@+id/op_mul"
                    android:src="@drawable/chenghao_mul_select"
                    android:scaleType="fitCenter"
                    android:layout_column="7"
                    android:text="@string/op_mul"
                    android:contentDescription="@string/description_mul"
                    android:layout_row="4"
                    android:layout_rowWeight="39"
                    android:layout_columnWeight="53"
                    style="@style/rom_four_button_style_mul_blue"/>
                <com.vivo.calculator.keybord.ColorButton
                    android:textSize="@dimen/windowmul_operate"
                    android:id="@+id/op_sub"
                    android:src="@drawable/minus_mul_select"
                    android:scaleType="fitCenter"
                    android:layout_column="7"
                    android:text="@string/jianhao"
                    android:contentDescription="@string/description_minus"
                    android:layout_row="6"
                    android:layout_rowWeight="39"
                    android:layout_columnWeight="53"
                    style="@style/rom_four_button_style_mul_blue"/>
                <com.vivo.calculator.keybord.ColorButton
                    android:textSize="@dimen/windowmul_operate"
                    android:id="@+id/op_add"
                    android:src="@drawable/plus_mul_select"
                    android:scaleType="fitCenter"
                    android:layout_column="7"
                    android:text="@string/op_add"
                    android:contentDescription="@string/description_plus"
                    android:layout_row="8"
                    android:layout_rowWeight="39"
                    android:layout_columnWeight="53"
                    style="@style/rom_four_button_style_mul_blue"/>
                <com.vivo.calculator.keybord.ColorButton
                    android:textSize="@dimen/windowmul_ac"
                    android:id="@+id/clr"
                    android:src="@drawable/ac_mul_select"
                    android:scaleType="fitCenter"
                    android:layout_column="1"
                    android:text="@string/text_ac"
                    android:contentDescription="@string/description_ac"
                    android:layout_row="2"
                    android:layout_rowWeight="39"
                    android:layout_columnWeight="53"
                    style="@style/rom_four_button_style_mul_blue"/>
                <com.vivo.calculator.keybord.ColorButton
                    android:id="@+id/clear"
                    android:background="@null"
                    android:src="@drawable/clear_mul_select"
                    android:scaleType="fitCenter"
                    android:layout_column="3"
                    android:text="@string/text_del"
                    android:contentDescription="@string/description_clear1"
                    android:layout_row="2"
                    android:layout_rowWeight="39"
                    android:layout_columnWeight="53"
                    style="@style/multiwindow_jia_button_normal_port"/>
                <com.vivo.calculator.keybord.ColorButton
                    android:textSize="@dimen/windowmul_operate"
                    android:id="@+id/positive_and_negative"
                    android:src="@drawable/a_and_m_mul_select"
                    android:scaleType="fitCenter"
                    android:layout_column="5"
                    android:text="@string/text_po_ne"
                    android:contentDescription="@string/description_po_ne"
                    android:layout_row="2"
                    android:layout_rowWeight="39"
                    android:layout_columnWeight="53"
                    style="@style/rom_four_button_style_mul_blue"/>
                <com.vivo.calculator.keybord.ColorButton
                    android:textSize="@dimen/windowmul_operate"
                    android:textColor="@color/equal_text_color"
                    android:id="@+id/eq"
                    android:src="@drawable/equal_bg_mul_selector"
                    android:scaleType="fitCenter"
                    android:layout_column="7"
                    android:text="@string/eq"
                    android:contentDescription="@string/eq"
                    android:layout_row="10"
                    android:layout_rowWeight="39"
                    android:layout_columnWeight="53"
                    style="@style/rom_four_button_style_mul_blue"/>
            </GridLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/delete_history_container"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true">
                <Button
                    android:id="@+id/delete_history"
                    style="@style/clearhistorybuttonstyle"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/history_view"
                android:background="@color/white_window_background_color"
                android:visibility="invisible"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_above="@+id/delete_history_container"
                android:layout_alignParentTop="true">
                <LinearLayout
                    android:id="@+id/history_list_layout"
                    android:background="@drawable/history_list_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:baselineAligned="false">
                    <ListView
                        android:id="@+id/history_list"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="@dimen/divide_line_height"
                        android:layout_marginTop="@dimen/divide_line_height"
                        android:layout_marginRight="@dimen/divide_line_height"
                        android:listSelector="#00000000"
                        android:divider="@drawable/list_item_divider"
                        android:dividerHeight="@dimen/divide_history_height"
                        android:layout_weight="1"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/no_history"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/no_history_data"
                        android:importantForAccessibility="yes">
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/no_history_icon"
                            android:importantForAccessibility="no"/>
                        <TextView
                            android:textColor="@color/exchange_net_notification_text_color"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="@string/no_history_data"
                            android:importantForAccessibility="no"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.vivo.calculator.HistoryLayout>
    </LinearLayout>
</RelativeLayout>
