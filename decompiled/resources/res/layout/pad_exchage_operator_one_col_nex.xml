<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pad_operator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_weight="@integer/keyguard_layout_rowWeight"
    android:rowCount="12"
    android:columnCount="1">
    <Space
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="0"
        android:layout_row="0"
        android:layout_rowWeight="@integer/keyguard_middle_layout_rowWeight"/>
    <com.vivo.calculator.keybord.ColorExButton
        android:textSize="@dimen/exchange_operate"
        android:id="@+id/e_op_div"
        android:src="@drawable/chuhao"
        android:layout_column="0"
        android:text="@string/op_div"
        android:contentDescription="@string/description_div"
        android:layout_row="1"
        android:layout_rowWeight="@integer/keyguard_layout_rowWeight"
        style="@style/nex_operator_button_style"/>
    <Space
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="0"
        android:layout_row="2"
        android:layout_rowWeight="@integer/keyguard_middle_layout_rowWeight"/>
    <com.vivo.calculator.keybord.ColorExButton
        android:textSize="@dimen/exchange_operate"
        android:id="@+id/e_op_sub"
        android:src="@drawable/minus"
        android:layout_column="0"
        android:text="@string/op_sub"
        android:contentDescription="@string/description_minus"
        android:layout_row="3"
        android:layout_rowWeight="@integer/keyguard_layout_rowWeight"
        style="@style/nex_operator_button_style"/>
    <Space
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="0"
        android:layout_row="4"
        android:layout_rowWeight="@integer/keyguard_middle_layout_rowWeight"/>
    <com.vivo.calculator.keybord.ColorExButton
        android:textSize="@dimen/exchange_operate"
        android:id="@+id/e_op_add"
        android:src="@drawable/plus"
        android:layout_column="0"
        android:text="@string/op_add"
        android:contentDescription="@string/description_plus"
        android:layout_row="5"
        android:layout_rowWeight="@integer/keyguard_layout_rowWeight"
        style="@style/nex_operator_button_style"/>
    <Space
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_column="0"
        android:layout_row="6"
        android:layout_rowWeight="@integer/keyguard_middle_layout_rowWeight"/>
    <com.vivo.calculator.keybord.ColorExButton
        android:textSize="@dimen/exchange_keyboard_equal"
        android:id="@+id/e_eq"
        android:background="@drawable/exchange_denghao_bg_selector_nex"
        android:src="@drawable/deng"
        android:scaleType="centerInside"
        android:layout_column="0"
        android:text="@string/text_equl"
        android:contentDescription="@string/eq"
        android:layout_row="7"
        android:layout_rowWeight="@integer/keyguard_equal_layout_rowWeight"
        style="@style/rom_four_button_equal_style"/>
    <com.vivo.calculator.keybord.ColorExButton
        android:gravity="center"
        android:id="@+id/lparen"
        android:background="@null"
        android:visibility="gone"
        android:layout_column="0"
        android:text="@string/lparen"
        android:contentDescription="@string/description_leftparen"
        android:layout_row="0"
        android:textDirection="ltr"
        android:layout_rowWeight="60"
        style="@style/rom_four_button_equal_style"/>
    <com.vivo.calculator.keybord.ColorExButton
        android:id="@+id/EE"
        android:background="@null"
        android:visibility="gone"
        android:layout_column="0"
        android:text="@string/text_EE"
        android:contentDescription="@string/description_ee"
        android:layout_row="0"
        android:layout_rowWeight="60"
        style="@style/rom_four_button_equal_style"/>
    <com.vivo.calculator.keybord.ColorExButton
        android:gravity="center"
        android:id="@+id/rparen"
        android:background="@null"
        android:visibility="gone"
        android:layout_column="0"
        android:text="@string/rparen"
        android:contentDescription="@string/description_rightparen"
        android:layout_row="0"
        android:textDirection="ltr"
        android:layout_rowWeight="60"
        style="@style/rom_four_button_equal_style"/>
</GridLayout>
