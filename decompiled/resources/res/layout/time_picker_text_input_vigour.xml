<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:gravity="center_horizontal"
        android:id="@+id/input_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr">
        <EditText
            android:textAppearance="@style/TextAppearance.Vigour.TimePicker.InputField"
            android:textColor="@color/text_timepcicker_input_text_vigour"
            android:gravity="center_horizontal"
            android:id="@+id/input_hour"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/vigour_picker_textinput_min_width"
            android:minHeight="@dimen/vigour_picker_textinput_min_height"
            android:inputType="number"
            android:imeOptions="actionNext"/>
        <TextView
            android:textSize="14dp"
            android:gravity="center"
            android:id="@+id/label_hour"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/vigour_picker_textinput_min_width"
            android:text="@string/time_picker_hour_label"
            android:layout_below="@+id/input_hour"
            android:layout_alignStart="@+id/input_hour"
            android:labelFor="@+id/input_hour"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Vigour.TimePicker.InputField"
            android:id="@+id/input_separator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vigour_timepicker_separator_padding"
            android:layout_marginRight="@dimen/vigour_timepicker_separator_padding"
            android:layout_alignBaseline="@+id/input_hour"
            android:layout_centerHorizontal="true"
            android:layout_toEndOf="@+id/input_hour"/>
        <EditText
            android:textAppearance="@style/TextAppearance.Vigour.TimePicker.InputField"
            android:textColor="@color/text_timepcicker_input_text_vigour"
            android:gravity="center_horizontal"
            android:id="@+id/input_minute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/vigour_picker_textinput_min_width"
            android:minHeight="@dimen/vigour_picker_textinput_min_height"
            android:layout_alignBaseline="@+id/input_hour"
            android:inputType="number"
            android:layout_toEndOf="@+id/input_separator"/>
        <TextView
            android:textSize="14dp"
            android:gravity="center"
            android:id="@+id/label_minute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/vigour_picker_textinput_min_width"
            android:text="@string/time_picker_minute_label"
            android:layout_below="@+id/input_minute"
            android:layout_alignStart="@+id/input_minute"
            android:labelFor="@+id/input_minute"/>
        <TextView
            android:textSize="14dp"
            android:textColor="?attr/colorError"
            android:id="@+id/label_error"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/time_picker_input_error"
            android:layout_below="@+id/input_hour"
            android:layout_alignStart="@+id/input_hour"
            android:accessibilityLiveRegion="assertive"/>
        <RadioGroup
            android:orientation="vertical"
            android:id="@+id/ampm_input_layout"
            android:paddingLeft="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAlignedChildIndex="1"
            android:layout_toRightOf="@+id/input_minute"
            android:layout_alignBaseline="@+id/input_minute"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="0dp">
            <RadioButton
                android:textAppearance="@style/TextAppearance.Vigour.TimePicker.AmPmLabel"
                android:textColor="@color/primary_text_secondary_when_activated_vigour_inverse"
                android:id="@+id/am_input_label"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="-23dp"
                android:button="@null"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:nextFocusForward="@+id/pm_label"/>
            <RadioButton
                android:textAppearance="@style/TextAppearance.Vigour.TimePicker.AmPmLabel"
                android:textColor="@color/primary_text_secondary_when_activated_vigour_inverse"
                android:id="@+id/pm_input_label"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@null"
                android:singleLine="true"
                android:includeFontPadding="false"/>
        </RadioGroup>
    </RelativeLayout>
</merge>
