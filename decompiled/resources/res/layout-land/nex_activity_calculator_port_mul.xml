<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/calculator_main_layout"
    android:background="@color/calculator_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/display_mul_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/display_mul_layout_height"
        android:baselineAligned="false">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <ImageButton
                android:id="@+id/history_toge_button"
                android:visibility="gone"
                android:layout_width="@dimen/btn_size"
                android:layout_height="@dimen/btn_size"
                android:layout_marginTop="@dimen/togglebutton_paddingbottom"
                android:layout_alignParentBottom="true"
                android:contentDescription="@string/history"/>
            <ImageButton
                android:id="@+id/calculator_mode_toge_button"
                android:background="@drawable/cal_toggle_btn"
                android:visibility="gone"
                android:layout_width="@dimen/btn_size"
                android:layout_height="@dimen/btn_size"
                android:layout_marginLeft="@dimen/togglebutton_paddingleft"
                android:layout_marginTop="@dimen/togglebutton_paddingbottom"
                android:layout_marginRight="@dimen/togglebutton_paddingleft"
                android:layout_alignParentBottom="true"
                android:contentDescription="@string/description_standard_mode"
                android:layout_toEndOf="@+id/history_toge_button"/>
            <TextView
                android:textSize="@dimen/windowmul_raddeg_land_textsize"
                android:textColor="@color/calculator_mode_color"
                android:gravity="right"
                android:id="@+id/mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="@dimen/raddeg_paddingTop_mul"
                android:text="@string/degradtext"
                android:layout_alignParentTop="true"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="right"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/result_area_margin_mul"
            android:layout_marginRight="@dimen/result_area_margin_mul"
            android:layout_weight="1">
            <com.vivo.calculator.CalculatorFormula
                android:textSize="20dp"
                android:textStyle="normal"
                android:textColor="@color/edit_text_color"
                android:textColorHighlight="@color/handle_color"
                android:gravity="center"
                android:id="@+id/formula"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="@dimen/calculator_input_height_nex_land_mul"
                android:contentDescription="@string/description_input"
                android:textSelectHandleLeft="@drawable/my_cursor"
                android:textSelectHandleRight="@drawable/my_cursor"
                android:textSelectHandle="@drawable/text_select_handle_middle"
                android:textCursorDrawable="@drawable/my_excursor"/>
            <com.vivo.calculator.CalculatorResult
                android:textSize="16dp"
                android:textStyle="normal"
                android:textColor="@color/result_text_color"
                android:textColorHighlight="@color/handle_color"
                android:gravity="center"
                android:id="@+id/result"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="@dimen/calculator_result_height_nex_land_mul"
                android:textSelectHandleLeft="@drawable/my_cursor"
                android:textSelectHandleRight="@drawable/my_cursor"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/keyboard_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/display_mul_layout">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/rom_four_padding_bottom_mul_nex"
            android:baselineAligned="false">
            <include layout="@layout/nex_activity_calculator_land_mul"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
