<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:id="@+id/time_header"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <com.vos.widget.VNumericTextView
        android:textAppearance="@style/TextAppearance.Vigour.TimePicker.TimeLabel"
        android:ellipsize="none"
        android:gravity="center_horizontal"
        android:id="@+id/hours"
        android:background="@drawable/vigour_time_picker_editable_background"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/vigour_picker_textinput_min_width"
        android:minHeight="@dimen/vigour_picker_textinput_min_height"
        android:singleLine="true"
        android:layout_toLeftOf="@+id/separator"
        android:layout_alignBaseline="@+id/separator"
        android:nextFocusForward="@+id/minutes"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:pointerIcon="hand"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Vigour.TimePicker.TimeLabel"
        android:id="@+id/separator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/vigour_timepicker_separator_padding"
        android:layout_marginRight="@dimen/vigour_timepicker_separator_padding"
        android:layout_centerInParent="true"
        android:importantForAccessibility="no"/>
    <com.vos.widget.VNumericTextView
        android:textAppearance="@style/TextAppearance.Vigour.TimePicker.TimeLabel"
        android:ellipsize="none"
        android:gravity="center_horizontal"
        android:id="@+id/minutes"
        android:background="@drawable/vigour_time_picker_editable_background"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/vigour_picker_textinput_min_width"
        android:minHeight="@dimen/vigour_picker_textinput_min_height"
        android:singleLine="true"
        android:layout_toRightOf="@+id/separator"
        android:layout_alignBaseline="@+id/separator"
        android:nextFocusForward="@+id/am_label"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:pointerIcon="hand"/>
    <RadioGroup
        android:orientation="vertical"
        android:id="@+id/ampm_layout"
        android:paddingLeft="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:baselineAlignedChildIndex="1"
        android:layout_toRightOf="@+id/minutes"
        android:layout_alignBaseline="@+id/minutes"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="0dp">
        <RadioButton
            android:textAppearance="@style/TextAppearance.Vigour.TimePicker.AmPmLabel"
            android:textColor="@color/primary_text_secondary_when_activated_vigour_inverse"
            android:id="@+id/am_label"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="-23dp"
            android:button="@null"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:nextFocusForward="@+id/pm_label"/>
        <RadioButton
            android:textAppearance="@style/TextAppearance.Vigour.TimePicker.AmPmLabel"
            android:textColor="@color/primary_text_secondary_when_activated_vigour_inverse"
            android:id="@+id/pm_label"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@null"
            android:singleLine="true"
            android:includeFontPadding="false"/>
    </RadioGroup>
</RelativeLayout>
