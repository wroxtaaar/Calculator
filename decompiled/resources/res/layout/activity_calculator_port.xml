<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/calculator_main_layout"
    android:background="@color/calculator_background"
    android:paddingLeft="0dp"
    android:paddingTop="0dp"
    android:paddingRight="0dp"
    android:paddingBottom="@dimen/calculator_paddingbottom_portrait"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/title_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_height"
        android:layout_alignParentTop="true"
        android:layoutDirection="locale">
        <ImageButton
            android:id="@+id/setting_button"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="@dimen/setting_btn_size"
            android:layout_height="@dimen/setting_btn_size"
            android:src="@drawable/setting_svg"
            android:contentDescription="@string/description_btn_setting"
            android:layout_marginEnd="@dimen/icon_margin_end"
            android:layout_alignParentEnd="true"/>
        <ImageButton
            android:id="@+id/open_window_button"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="@dimen/setting_btn_size"
            android:layout_height="@dimen/setting_btn_size"
            android:src="@drawable/open_window"
            android:contentDescription="@string/desc_show_by_frame"
            android:layout_marginStart="@dimen/icon_margin_start"
            android:layout_alignParentStart="true"/>
    </RelativeLayout>
    <LinearLayout
        android:textStyle="normal"
        android:gravity="right"
        android:orientation="vertical"
        android:id="@+id/touchlayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/keyboard_layout"
        android:layout_below="@+id/title_layout"
        android:layout_marginStart="@dimen/result_area_margins"
        android:layout_marginEnd="@dimen/result_area_margins">
        <com.vivo.calculator.CalculatorFormula
            android:textSize="@dimen/input_size"
            android:textColor="@color/edit_text_color"
            android:textColorHighlight="@color/handle_color"
            android:gravity="center"
            android:id="@+id/formula"
            android:background="@null"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/calculator_input_height"
            android:layout_marginTop="@dimen/calculator_display_margin_title"
            android:singleLine="true"
            android:textSelectHandleLeft="@drawable/my_cursor"
            android:textSelectHandleRight="@drawable/my_cursor"
            android:textSelectHandle="@drawable/text_select_handle_middle"
            android:textCursorDrawable="@drawable/my_cursor"/>
        <com.vivo.calculator.CalculatorResult
            android:textSize="@dimen/result_size"
            android:textStyle="normal"
            android:textColor="@color/result_text_color"
            android:textColorHighlight="@color/handle_color"
            android:gravity="center"
            android:id="@+id/result"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="@dimen/calculator_result_height"
            android:textSelectHandleLeft="@drawable/my_cursor"
            android:textSelectHandleRight="@drawable/my_cursor"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/button_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/keyboard_layout">
        <ImageButton
            android:id="@+id/history_toge_button"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/history_open"
            android:contentDescription="@string/description_history_open"
            android:layout_marginStart="@dimen/togglebutton_marginleft"
            style="@style/togglebutton_style"/>
        <ImageButton
            android:id="@+id/calculator_mode_toge_button"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/cal_toggle_btn"
            android:contentDescription="@string/description_scientific_mode"
            android:layout_toEndOf="@+id/history_toge_button"
            style="@style/togglebutton_style"/>
        <ImageButton
            android:id="@+id/exchange_toge_button"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/exchange_rate"
            android:contentDescription="@string/description_btn_exchange"
            android:layout_toEndOf="@+id/calculator_mode_toge_button"
            style="@style/togglebutton_style"/>
        <com.vivo.calculator.keybord.ColorButton
            android:id="@+id/del"
            android:background="@null"
            android:paddingBottom="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/del_select"
            android:alpha="0"
            android:paddingStart="0dp"
            android:paddingEnd="39dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:id="@+id/divid_layout"
        android:background="@color/line_of_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divide_line_height"
        android:layout_marginLeft="@dimen/line_margin_right"
        android:layout_marginRight="@dimen/line_margin_right"
        android:layout_above="@+id/keyboard_layout"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/keyboard_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/keybord_height"
        android:baselineAligned="false"
        android:layout_alignParentBottom="true"
        android:paddingStart="@dimen/keybord_margin"
        android:paddingEnd="@dimen/keybord_margin">
        <com.vivo.calculator.HistoryLayout
            android:id="@+id/history_layout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="@integer/keguard_main_weight">
            <include
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/pad_numeric"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/delete_history_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="@dimen/history_layout_margin_end">
                <Button
                    android:id="@+id/delete_history"
                    android:background="@drawable/clear_history_selector"
                    android:textAllCaps="false"
                    style="@style/clearhistorybuttonstyle"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/history_view"
                android:background="@color/calculator_background"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/history_layout_margin_top"
                android:layout_above="@+id/delete_history_container"
                android:layout_alignParentTop="true"
                android:layout_marginEnd="@dimen/history_layout_margin_end">
                <LinearLayout
                    android:id="@+id/history_list_layout"
                    android:background="@drawable/history_list_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:baselineAligned="false">
                    <ListView
                        android:id="@+id/history_list"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="@dimen/divide_line_height"
                        android:layout_marginTop="@dimen/divide_line_height"
                        android:layout_marginRight="@dimen/divide_line_height"
                        android:listSelector="@drawable/list_item_background_selector"
                        android:divider="@drawable/list_item_divider"
                        android:dividerHeight="@dimen/divide_history_height"
                        android:layout_weight="1"/>
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/no_history"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/no_history_data"
                        android:importantForAccessibility="yes">
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/no_history_icon"
                            android:importantForAccessibility="no"/>
                        <TextView
                            android:textColor="@color/exchange_net_notification_text_color"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="@string/no_history_data"
                            android:importantForAccessibility="no"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.vivo.calculator.HistoryLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="@integer/keguard_one_col_weight">
            <include layout="@layout/pad_operator"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
