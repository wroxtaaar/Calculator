<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/calculator_main_layout"
    android:background="@color/calculator_background"
    android:paddingLeft="0dp"
    android:paddingTop="0dp"
    android:paddingRight="0dp"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/title_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_height_nex"
        android:layout_alignParentTop="true"
        android:layoutDirection="locale">
        <ImageButton
            android:id="@+id/setting_button"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="@dimen/setting_btn_size"
            android:layout_height="@dimen/setting_btn_size"
            android:src="@drawable/setting_svg"
            android:contentDescription="@string/description_btn_setting"
            android:layout_marginEnd="@dimen/icon_margin_nex"
            android:layout_alignParentEnd="true"/>
        <ImageButton
            android:id="@+id/open_window_button"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="@dimen/setting_btn_size"
            android:layout_height="@dimen/setting_btn_size"
            android:src="@drawable/open_window"
            android:contentDescription="@string/desc_show_by_frame"
            android:layout_marginStart="@dimen/icon_margin_nex"
            android:layout_alignParentStart="true"/>
    </RelativeLayout>
    <LinearLayout
        android:textStyle="normal"
        android:gravity="right"
        android:orientation="vertical"
        android:id="@+id/touchlayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/title_layout"
        android:layout_marginStart="@dimen/touch_layout_margin_nex"
        android:layout_marginEnd="@dimen/touch_layout_margin_nex">
        <TextView
            android:textSize="@dimen/raddeg_textsize"
            android:textColor="@color/calculator_mode_color"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/mode"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/calculator_display_margin_title"
            android:text="@string/degradtext"
            android:maxLines="2"/>
        <com.vivo.calculator.CalculatorFormula
            android:textSize="@dimen/input_size_nex"
            android:textColor="@color/edit_text_color"
            android:textColorHighlight="@color/handle_color"
            android:gravity="center"
            android:id="@+id/formula"
            android:background="@null"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/calculator_input_height_nex"
            android:layout_marginTop="@dimen/calculator_display_margin_title_nex"
            android:singleLine="true"
            android:textSelectHandleLeft="@drawable/my_cursor"
            android:textSelectHandleRight="@drawable/my_cursor"
            android:textSelectHandle="@drawable/text_select_handle_middle"
            android:textCursorDrawable="@drawable/my_cursor"/>
        <com.vivo.calculator.CalculatorResult
            android:textSize="@dimen/result_size_nex"
            android:textStyle="normal"
            android:textColor="@color/result_text_color"
            android:textColorHighlight="@color/handle_color"
            android:gravity="center"
            android:id="@+id/result"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="@dimen/calculator_result_height_nex"
            android:textSelectHandleLeft="@drawable/my_cursor"
            android:textSelectHandleRight="@drawable/my_cursor"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/button_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/keyguard">
        <ImageButton
            android:id="@+id/history_toge_button"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/history_open"
            android:contentDescription="@string/description_history_open"
            android:layout_marginStart="@dimen/normal_margin_nex"
            style="@style/togglebutton_style"/>
        <ImageButton
            android:id="@+id/calculator_mode_toge_button"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/cal_toggle_btn"
            android:contentDescription="@string/description_scientific_mode"
            android:layout_toEndOf="@+id/history_toge_button"
            style="@style/togglebutton_style"/>
        <ImageButton
            android:id="@+id/exchange_toge_button"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/exchange_rate"
            android:contentDescription="@string/description_btn_exchange"
            android:layout_toEndOf="@+id/calculator_mode_toge_button"
            style="@style/togglebutton_style"/>
        <com.vivo.calculator.keybord.ColorButton
            android:id="@+id/del"
            android:background="@null"
            android:paddingBottom="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/del_select"
            android:alpha="0"
            android:paddingStart="0dp"
            android:paddingEnd="39dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:id="@+id/divid_layout"
        android:background="@color/line_of_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divide_line_height"
        android:layout_marginLeft="@dimen/line_margin_right"
        android:layout_marginRight="@dimen/line_margin_right"
        android:layout_above="@+id/keyguard"/>
    <RelativeLayout
        android:id="@+id/keyguard"
        android:layout_width="match_parent"
        android:layout_height="@dimen/keyboard_height_nex"
        android:layout_alignParentBottom="true">
        <include layout="@layout/keyguard_layout"/>
        <include layout="@layout/keyguard_layout_land"/>
    </RelativeLayout>
</RelativeLayout>
