<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/raddeg_textsize"
            android:textStyle="bold"
            android:textColor="@color/symbol_text_color"
            android:ellipsize="end"
            android:layout_gravity="right"
            android:id="@+id/datetime"
            android:paddingLeft="@dimen/historylistpadding"
            android:paddingRight="@dimen/historylistpadding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxLines="1"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/list_item_background_selector"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/historylist_processrad_textsize"
                android:textColor="@color/history_input_edit_color"
                android:layout_gravity="right"
                android:id="@+id/raddeg"
                android:paddingLeft="@dimen/historylistpadding"
                android:paddingRight="@dimen/historylistpadding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="@dimen/historylist_processrad_textsize"
                android:textColor="@color/history_input_edit_color"
                android:layout_gravity="right"
                android:id="@+id/calculator_process"
                android:paddingLeft="@dimen/historylistpadding"
                android:paddingRight="@dimen/historylistpadding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:textDirection="ltr"/>
            <TextView
                android:textSize="@dimen/historylist_result_textsize"
                android:textColor="@color/history_result_text_color"
                android:layout_gravity="right"
                android:id="@+id/calculator_result"
                android:paddingLeft="@dimen/historylistpadding"
                android:paddingRight="@dimen/historylistpadding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp"
                android:textDirection="ltr"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
