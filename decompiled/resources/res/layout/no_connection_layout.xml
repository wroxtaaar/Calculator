<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/no_net_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/no_connect_image"
            android:background="@drawable/reconnet_network_svg"
            android:visibility="visible"
            android:layout_width="@dimen/exchange_net_image_height"
            android:layout_height="@dimen/exchange_net_image_height"
            android:contentDescription=""/>
        <TextView
            android:textSize="@dimen/exchange_net_text_size"
            android:textColor="@color/exchange_net_notification_text_color"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/net_title"
            android:layout_width="@dimen/exchange_net_text_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/exchange_net_text_top"
            android:text="@string/no_network_msg"/>
        <Button
            android:id="@+id/no_net_refresh"
            android:layout_marginTop="@dimen/exchange_net_setting_button_top"
            android:text="@string/retry"
            android:textAllCaps="false"
            style="@style/net_error_button_style"/>
        <Button
            android:id="@+id/no_net_setting"
            android:layout_marginTop="@dimen/exchange_net_button_top"
            android:text="@string/network_setting"
            android:textAllCaps="false"
            style="@style/net_error_button_style"/>
    </LinearLayout>
</ScrollView>
