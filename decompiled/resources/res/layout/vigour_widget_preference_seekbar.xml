<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/vigour_listPreferredItemHeight"
    android:paddingStart="@dimen/vigour_listPreferredItemPadding_start"
    android:paddingEnd="@dimen/vigour_listPreferredItemPadding_end">
    <LinearLayout
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/icon_frame"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="14dp">
        <androidx.preference.internal.PreferenceImageView
            android:id="@android:id/icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:maxHeight="40dp"
            app:maxWidth="40dp"/>
    </LinearLayout>
    <RelativeLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:layout_weight="1"
        android:layout_marginEnd="8dp">
        <TextView
            android:textAppearance="@style/Preference_TextAppearanceVigourSubhead"
            android:textSize="@dimen/vigour_preference_title_textSize"
            android:textColor="@color/text_color_primary_vigour"
            android:ellipsize="marquee"
            android:id="@android:id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceListItemSecondary"
            android:textSize="@dimen/vigour_preference_summary_textSize"
            android:textColor="@color/text_color_secondary_vigour"
            android:id="@android:id/summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="10"
            android:layout_below="@android:id/title"
            android:layout_alignStart="@android:id/title"/>
        <androidx.preference.UnPressableLinearLayout
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@android:id/summary"
            android:layout_alignStart="@android:id/title">
            <SeekBar
                android:id="@+id/seekbar"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="0dp"
                android:paddingEnd="22dp"/>
            <TextView
                android:textAppearance="@style/Preference_TextAppearanceVigourSubhead"
                android:ellipsize="marquee"
                android:gravity="center"
                android:id="@+id/seekbar_value"
                android:scrollbars="none"
                android:fadingEdge="horizontal"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                android:singleLine="true"
                android:fontFamily="sans-serif-condensed"/>
        </androidx.preference.UnPressableLinearLayout>
    </RelativeLayout>
</LinearLayout>
