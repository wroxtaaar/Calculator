<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="horizontal"
    android:id="@+id/keyboard_layout"
    android:layout_width="match_parent"
    android:layout_height="@dimen/keyboard_height_nex"
    android:layout_marginTop="@dimen/keyguard_margin_top_nex"
    android:layout_marginBottom="@dimen/keyguard_margin_bottom_nex"
    android:baselineAligned="false"
    android:layout_alignParentBottom="true"
    android:paddingStart="@dimen/normal_margin_nex"
    android:paddingEnd="@dimen/normal_margin_nex">
    <com.vivo.calculator.HistoryLayout
        android:id="@+id/history_layout"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="@integer/keguard_main_weight">
        <include
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/nex_pad_numeric"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/delete_history_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <Button
                android:id="@+id/delete_history"
                android:background="@drawable/clear_history_selector"
                android:textAllCaps="false"
                style="@style/clearhistorybuttonstyle"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/history_view"
            android:background="@color/calculator_background"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/delete_history_container"
            android:layout_alignParentTop="true">
            <LinearLayout
                android:id="@+id/history_list_layout"
                android:background="@drawable/history_list_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:baselineAligned="false">
                <ListView
                    android:id="@+id/history_list"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/divide_line_height"
                    android:layout_marginTop="@dimen/divide_line_height"
                    android:layout_marginRight="@dimen/divide_line_height"
                    android:listSelector="@drawable/list_item_background_selector"
                    android:divider="@drawable/list_item_divider"
                    android:dividerHeight="@dimen/divide_history_height"
                    android:layout_weight="1"/>
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/no_history"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/no_history_data"
                    android:importantForAccessibility="yes">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/no_history_icon"
                        android:importantForAccessibility="no"/>
                    <TextView
                        android:textColor="@color/exchange_net_notification_text_color"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/no_history_data"
                        android:importantForAccessibility="no"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.vivo.calculator.HistoryLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="@integer/keguard_one_col_weight">
        <include layout="@layout/nex_pad_operator_one_col"/>
    </LinearLayout>
</LinearLayout>
